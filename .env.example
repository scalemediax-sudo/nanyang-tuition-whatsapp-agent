# ── Meta / WhatsApp Cloud API ─────────────────────────────────────────────────
# Found in Meta for Developers → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_permanent_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Any random string you choose — paste the same value in Meta's webhook settings
VERIFY_TOKEN=my_super_secret_verify_token

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your_openai_api_key_here
